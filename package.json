{
  "name": "forge",
  "version": "0.1.0",
  "description": "Forge — a JetBrains-style IDE",
  "private": true,
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node tests/run-all.cjs",
    "test:unit": "node tests/unit/run.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bash-language-server": "^5.8.1",
    "dictionary-en": "^4.0.0",
    "diff": "^9.0.0",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "dompurify": "^3.4.17",
    "emmet": "^2.4.11",
    "iconv-lite": "^0.7.3",
    "marked": "^18.1.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "nspell": "^2.1.5",
    "pyright": "^1.1.414",
    "sql.js": "^1.15.1",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.2",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-languageserver-protocol": "^3.18.4",
    "ws": "^8.22.0",
    "yaml-language-server": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nspell": "^2.1.6",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.15",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "packageManager": "pnpm@10.30.3",
  "build": {
    "appId": "com.0xmortuex.forge",
    "productName": "Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/forge.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    }
  }
}
