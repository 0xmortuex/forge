    "@xterm/xterm": "^6.0.0",
    "bash-language-server": "^5.8.1",
    "dictionary-en": "^4.0.0",
    "diff": "^9.0.0",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "dompurify": "^3.4.17",
    "emmet": "^2.4.11",
    "marked": "^18.1.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "nspell": "^2.1.5",
    "pyright": "^1.1.414",
    "sql.js": "^1.15.1",
    "typescript-language-server": "^6.0.2",
